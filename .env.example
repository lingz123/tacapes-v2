# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# `tacapes.cli` calls `load_dotenv()` at startup; real env vars take precedence.

# Required: every LLM call.
ANTHROPIC_API_KEY=

# Required by the M3 sub-theme researcher's `web_search` tool.
# Free tier: https://app.tavily.com  (1k searches/mo)
TAVILY_API_KEY=

# Required by the M3 sub-theme researcher's `fetch_news` tool.
# Free tier: https://newsapi.org  (100 requests/day)
NEWSAPI_KEY=

# Optional: Alpha Vantage. Only needed if you reconfigure TradingAgents to
# use Alpha Vantage instead of yfinance for fundamentals/news.
# ALPHA_VANTAGE_API_KEY=

# Postgres (matches docker-compose.yml service `db`)
DATABASE_URL=postgresql+psycopg://tacapes:tacapes@127.0.0.1:5433/tacapes
